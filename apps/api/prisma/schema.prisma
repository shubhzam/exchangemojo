// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Market {
  SOLUSDC
  ETHUSDC
  BTCUSDC
}

enum OrderSide {
  BUY
  SELL
}

enum OrderStatus {
  NEW
  PARTIALLY_FILLED
  FILLED
  CANCELED
}

model Order {
  id                String      @id @default(uuid(7))
  accountId         String
  market            Market
  side              OrderSide
  price             Decimal     @db.Decimal(18, 8)
  quantity          Decimal     @db.Decimal(18, 8)
  remainingQuantity Decimal     @db.Decimal(18, 8)
  status            OrderStatus @default(NEW)
  createdAt         DateTime    @default(now())

  account     Account  @relation(fields: [accountId], references: [id])
  makerTrades Trade[]  @relation("MakerOrder")
  takerTrades Trade[]  @relation("TakerOrder")

  @@index([market, status, price])
}

model Trade {
  id           String   @id @default(uuid(7))
  market       Market
  price        Decimal  @db.Decimal(18, 8)
  quantity     Decimal  @db.Decimal(18, 8)
  makerOrderId String
  takerOrderId String
  makerOrder   Order    @relation("MakerOrder", fields: [makerOrderId], references: [id])
  takerOrder   Order    @relation("TakerOrder", fields: [takerOrderId], references: [id])
  createdAt    DateTime @default(now())
}

enum Asset {
  USDC
  SOL
  ETH
  BTC
}

model Account {
  id        String   @id @default(uuid(7))
  createdAt DateTime @default(now())

  balances Balance[]
  orders   Order[]
}

model Balance {
  accountId String
  asset     Asset
  free      Decimal @default(0) @db.Decimal(18, 8)
  locked    Decimal @default(0) @db.Decimal(18, 8)

  account Account @relation(fields: [accountId], references: [id])

  @@id([accountId, asset])
}